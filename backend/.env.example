# Cloudflare Workers AI (required for AI-generated stock and catalyst summaries)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# Public API -> private AI service
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TIMEOUT_SECONDS=180

# Local PostgreSQL from compose.yaml
DATABASE_URL=postgresql+psycopg://samjhao:samjhao_local_dev@127.0.0.1:5432/samjhao

# Local browser authentication
AUTH_COOKIE_NAME=samjhao_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_SESSION_DAYS=14
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
